# ---------------------------------------------------------------------------
# DeepFlow configuration. Copy to .env and fill in. NEVER commit .env.
# Every value here is read via pydantic-settings (src/deepflow/config/settings.py).
# ---------------------------------------------------------------------------

# --- Run mode -------------------------------------------------------------
# BACKTEST | PAPER | SHADOW | LIVE   (LIVE is refused unless the two
# confirmation flags below are also set -- see settings.py)
DEEPFLOW_MODE=PAPER
DEEPFLOW_LIVE_TRADING_CONFIRMED=false
DEEPFLOW_LIVE_TRADING_ACK=

# --- Polymarket credentials ----------------------------------------------
# Order signer. Use a dedicated, least-privilege key, and prefer injecting it
# from a secret manager rather than a .env file. Signing alone is NOT enough for
# gasless relayer operations -- see the relayer key below.
DEEPFLOW_POLYMARKET__PRIVATE_KEY=
# Account wallet holding collateral and positions. For a Deposit, Safe or Proxy
# wallet this is NOT the signer address, and it must be set explicitly: the
# wallet type decides the order signature_type (deposit=3, proxy=1, safe=2,
# eoa=0), and given only a key the SDK would sign as an EOA.
DEEPFLOW_POLYMARKET__WALLET_ADDRESS=
# deposit | proxy | safe | eoa. Accounts created on or after 2026-05-04 are
# deposit wallets; proxy and safe are legacy.
DEEPFLOW_POLYMARKET__WALLET_TYPE=deposit
# Relayer API key (polymarket.com/settings?tab=api-keys). Required in LIVE mode:
# without it the four exchange approvals cannot be granted and resolved
# positions cannot be redeemed, even though order placement works.
DEEPFLOW_POLYMARKET__RELAYER_API_KEY=
DEEPFLOW_POLYMARKET__RELAYER_API_KEY_ADDRESS=
# SDK environment name: prod | staging
DEEPFLOW_POLYMARKET__ENVIRONMENT=prod

# --- Storage --------------------------------------------------------------
DEEPFLOW_DATABASE__DSN=postgresql+asyncpg://deepflow:deepflow@localhost:5432/deepflow
DEEPFLOW_REDIS__DSN=redis://localhost:6379/0

# --- Dashboard API --------------------------------------------------------
DEEPFLOW_API__HOST=127.0.0.1
DEEPFLOW_API__PORT=8000
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
DEEPFLOW_API__JWT_SECRET=
DEEPFLOW_API__CORS_ORIGINS=["http://localhost:3000"]

# --- Observability --------------------------------------------------------
DEEPFLOW_LOG_LEVEL=INFO
DEEPFLOW_LOG_FORMAT=json
